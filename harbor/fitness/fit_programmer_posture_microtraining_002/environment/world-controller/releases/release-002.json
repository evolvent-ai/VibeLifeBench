      "op": "insert",
      "values": {
        "review_id": "rev_mobility_intro_recent",
        "merchant_id": "course_mobility_intro_0710",
        "user_id": "reviewer_course_0704",
        "rating": 4,
        "body": "The movements in the trial class are slow-paced, and the coach asks about previous injuries; the page clearly states that cancellation is allowed. Paid packages are introduced afterward, but there is no pressure to close the sale on the spot.",
